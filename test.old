services:
  postgresql:
    container_name: postgresql
    image: postgres
    ports:
      - "5432:5432"
    env_file:
      - ./worker/.env
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      PGDATA: /data/postgres
  
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER}"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    
    volumes:
      - backend-data:/data/postgres
    networks:
      - posgres-network

  adminer:
    image: adminer
    ports:
      - 8088:8088
    depends_on:
      postgresql:
        condition:service_healthy
    networks:
      - postgres-network

  rabbitmq:
    container_name: rabbitmq
    image: rabbitmq:4-management
    ports:
      - "5672:5672"
      - "15672:15672"

  minios3:
    container_name: minios3
    image: minio/minio
    ports:
      - "9000:9000"
      - "9001:9001"
    command: server /data --console-address ":9001"

  backend:
    container_name: backend
    image: kino/backend
    build:
      dockerfile: ./backend/Dockerfile
    ports:
      - "8000:8000"
    env_file:
      - ./backend/.env
    depends_on:
      postgresql:
        condition: service_healthy
    networks:
      - postgres-network


  mlflow:
    container_name: mlflow
    hostname: mlflow
    image: ghcr.io/mlflow/mlflow
    ports:
      - "5000:5000"
    env_file:
      - ./worker/.env
    command: >
      sh -c "pip install psycopg2-binary && 
      mlflow server 
      --host 0.0.0.0 
      --port 5000 
      --backend-store-uri postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgresql:5432/${POSTGRES_MLFLOW_DB} 
      --default-artifact-root s3://mlops/
      --allowed-hosts mlflow:5000,localhost:5000"
    networks:
      - postgres-network

  worker:
    container_name: worker
    image: bert/worker
    build:
      dockerfile: ./worker/Dockerfile
    
    depends_on:
      - backend
      - mlflow
      - rabbitmq

  prometheus:
    image: prom/prometheus:latest
    volumes:
      - ./worker/prometheus/etc:/etc/prometheus/
      - ./worker/prometheus/data:/prometheus
    container_name: prometheus
    hostname: prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
    ports:
      - 9090:9090
    depends_on:
      - worker

  node-exporter:
    image: prom/node-exporter
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    container_name: exporter
    hostname: exporter
    command:
      - --path.procfs=/host/proc
      - --path.sysfs=/host/sys
      - --collector.filesystem.ignored-mount-points
      - ^/(sys|proc|dev|host|etc|rootfs/var/lib/docker/containers|rootfs/var/lib/docker/overlay2|rootfs/run/docker/netns|rootfs/var/lib/docker/aufs)($$|/)
    ports:
      - 9100:9100
  
  grafana:
    image: grafana/grafana
    user: root
    ports:
      - 3000:3000
    volumes:
      - ./worker/grafana:/var/lib/grafana
      - ./worker/grafana/provisioning/:/etc/grafana/provisioning/
    container_name: grafana
    hostname: grafana
    depends_on:
      - prometheus


volumes:
  backend-data:

networks:
  postgres-network:
    driver: bridge